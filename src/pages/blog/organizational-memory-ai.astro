  <div class="overflow-x-auto my-6">
    <table class="w-full text-xs text-left border-collapse border border-ink-900/15">
      <thead>
        <tr class="bg-cream-100">
          <th class="p-3 border border-ink-900/15 font-serif text-ink-900">Feature</th>
          <th class="p-3 border border-ink-900/15 font-serif text-ink-900">Traditional Manual Wiki</th>
          <th class="p-3 border border-ink-900/15 font-serif text-ink-900">AI Organizational Memory (Nexus AI)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="p-3 border border-ink-900/15 font-semibold">Maintenance</td>
          <td class="p-3 border border-ink-900/15">Manual human writing; quickly goes stale.</td>
          <td class="p-3 border border-ink-900/15">Automated background indexing across tools.</td>
        </tr>
        <tr>
          <td class="p-3 border border-ink-900/15 font-semibold">Context Capture</td>
          <td class="p-3 border border-ink-900/15">Only captures what someone bothers to type up.</td>
          <td class="p-3 border border-ink-900/15">Captures the complete discussion rationale and trade-offs.</td>
        </tr>
        <tr>
          <td class="p-3 border border-ink-900/15 font-semibold">Employee Transitions</td>
          <td class="p-3 border border-ink-900/15">Departing employee leaves hurried bullet points.</td>
          <td class="p-3 border border-ink-900/15">Auto-generates complete zero-loss handover briefs.</td>
        </tr>
        <tr>
          <td class="p-3 border border-ink-900/15 font-semibold">Searchability</td>
          <td class="p-3 border border-ink-900/15">Keyword exact matches only.</td>
