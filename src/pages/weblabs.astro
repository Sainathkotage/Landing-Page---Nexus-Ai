---
import Layout from '../layouts/Layout.astro';
import { WebLabsPageModern } from '../components/weblabs/WebLabsPageModern';

const domain = "https://www.aixentrix.com";

const seoTitle = "WebLabs | Complete Online Presence & Professional Websites for Businesses";
const seoDescription = "WebLabs provides modern, credible websites and the complete online presence your business needs. Turnkey custom design, domain, hosting, SSL, search discovery, and instant lead capture.";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "WebLabs by Aixentrix",
  "serviceType": "High-Performance Website Design and Development",
  "priceRange": "$$",
  "url": `${domain}/weblabs`,
  "telephone": "+91-9021509565",
  "email": "contact@aixentrix.com",
  "description": seoDescription,
  "provider": {
    "@type": "Organization",
    "name": "Aixentrix",
    "url": domain
  }
};
---

<Layout 
  title={seoTitle} 
  description={seoDescription} 
  canonical={`${domain}/weblabs`}
  bodyClass="bg-[#070709] text-white selection:bg-white/20 selection:text-white"
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <WebLabsPageModern client:load />
</Layout>
