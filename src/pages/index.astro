---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/landing/Navbar';
import { Footer } from '../components/landing/Footer';

const domain = "https://www.aixentrix.com";

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Aixentrix",
  "legalName": "Aixentrix, Inc.",
  "url": domain,
  "logo": `${domain}/logo.png`,
  "email": "info.aixentrix@gmail.com",
  "description": "Aixentrix is an AI technology software company that develops Nexus AI, the AI Chief of Staff for modern teams, and WebLabs, providing bespoke website development and complete digital presence for businesses.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Nagpur",
    "addressRegion": "Maharashtra",
    "addressCountry": "IN"
  },
  "sameAs": [
    "https://github.com/Sainathkotage/Nexus-Ai",
    "https://www.linkedin.com/in/sainathkotage/",
    "https://x.com/AixentrixNexus"
  ]
};
---

<Layout 
  title="Aixentrix — AI Products, Software & Digital Solutions" 
  description="Aixentrix is an AI technology company that develops Nexus AI, the AI Chief of Staff for modern teams, and WebLabs, providing bespoke website engineering and complete digital presence."
>
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <Navbar client:load />

  <main class="relative z-10 font-sans selection:bg-accent-500/20 text-ink-900 antialiased paper-texture relative overflow-hidden pt-32 pb-24">
    <!-- Hero Section -->
    <section class="max-w-5xl mx-auto px-6 text-center mb-20">
      <div class="vintage-divider text-xs font-semibold uppercase tracking-[0.3em] mb-8 text-ink-500">
        <span class="flourish text-base">✦</span>
        <span class="mx-3">AI-Powered Business Solutions</span>
        <span class="flourish text-base">✦</span>
      </div>

      <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl font-semibold leading-[1.1] tracking-tight text-ink-900 mb-6 max-w-4xl mx-auto">
        Empowering Businesses from <span class="italic font-normal">Internal Operations</span> to <span class="italic font-normal">Digital Presence</span>.
      </h1>
      
      <p class="text-base md:text-lg text-ink-700 font-sans leading-relaxed max-w-3xl mx-auto mb-10">
        Aixentrix is an AI technology company built to solve the two biggest bottlenecks modern businesses face: internal operational friction and external digital invisibility. We provide <strong class="font-semibold text-ink-900">Nexus AI</strong> to unify team memory and execution into an intelligent workspace, and <strong class="font-semibold text-ink-900">WebLabs</strong> to build modern, credible websites that turn online searches into paying customers.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="/nexus-ai" 
          class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-ink-900 hover:bg-accent-950 text-cream-50 font-medium text-xs tracking-wider uppercase transition-all shadow-md flex items-center justify-center gap-2 hover:scale-[1.02] duration-200"
        >
          Explore Nexus AI Workspace <span>→</span>
        </a>
        <a 
          href="/weblabs" 
          class="w-full sm:w-auto px-8 py-3.5 rounded-full border border-ink-900/20 hover:border-ink-900/50 bg-cream-50/80 text-ink-900 font-medium text-xs tracking-wider uppercase transition-all hover:bg-ink-900/[0.04] hover:scale-[1.02] duration-200 flex items-center justify-center gap-2"
        >
          Build a Website with WebLabs <span>→</span>
        </a>
      </div>

      <!-- Quick Highlights -->
      <div class="mt-14 pt-8 border-t border-ink-900/10 grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
        <div class="space-y-1">
          <div class="font-serif text-xl md:text-2xl font-semibold text-ink-900">AI-Native</div>
          <div class="text-[11px] font-sans text-ink-500 uppercase tracking-wider">Internal Workspace Memory</div>
        </div>
        <div class="space-y-1">
          <div class="font-serif text-xl md:text-2xl font-semibold text-ink-900">&lt; 1s Speeds</div>
          <div class="text-[11px] font-sans text-ink-500 uppercase tracking-wider">Edge-Hosted Web Platforms</div>
        </div>
        <div class="space-y-1">
          <div class="font-serif text-xl md:text-2xl font-semibold text-ink-900">Zero-Loss</div>
          <div class="text-[11px] font-sans text-ink-500 uppercase tracking-wider">Automated Team Handovers</div>
        </div>
        <div class="space-y-1">
          <div class="font-serif text-xl md:text-2xl font-semibold text-ink-900">Credibility</div>
          <div class="text-[11px] font-sans text-ink-500 uppercase tracking-wider">Local SEO & Verified Schema</div>
        </div>
      </div>
    </section>

    <!-- The Two Core Problems We Solve Section -->
    <section class="max-w-5xl mx-auto px-6 mb-24">
      <div class="text-center mb-12">
        <div class="text-xs font-mono font-bold text-accent-600 uppercase tracking-widest mb-2">The Dual Challenge</div>
        <h2 class="font-serif text-3xl md:text-4xl font-semibold text-ink-900">
          The Two Friction Points Holding Businesses Back
        </h2>
        <p class="text-xs md:text-sm text-ink-600 max-w-xl mx-auto mt-2 font-sans">
          Whether you are a fast-growing startup or an established local business, scalable success requires running smoothly on the inside and looking credible on the outside.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Problem & Solution 1: Internal -->
        <div class="border border-ink-900/15 bg-cream-50/70 p-8 rounded-sm shadow-sm flex flex-col justify-between vintage-border relative">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold text-accent-600 uppercase tracking-widest font-mono">01 / Inside the Company</span>
              <span class="px-2.5 py-0.5 rounded-full bg-accent-500/10 text-accent-700 text-[10px] font-mono font-bold uppercase">Operational Friction</span>
            </div>
            <h3 class="font-serif text-2xl font-semibold text-ink-900 mb-3">
              Fragmented Tools & Lost Company Memory
            </h3>
            <p class="text-xs md:text-sm text-ink-600 leading-relaxed font-sans mb-6">
              Teams lose hours switching between isolated apps: chat, emails, project boards, and stale wikis. When team members change or leave, valuable context and decisions disappear into fragmented data silos.
            </p>
            <div class="border-t border-ink-900/10 pt-4 space-y-2">
              <div class="text-xs font-semibold text-ink-900 font-serif">How Aixentrix Solves It:</div>
              <p class="text-xs text-ink-700 font-sans leading-relaxed">
                <strong class="font-semibold text-ink-950">Nexus AI</strong> consolidates email, calendar, tasks, and documentation into a single AI-assisted workspace that triages your schedule, writes daily briefs, and captures permanent team memory.
              </p>
            </div>
          </div>
          <div class="pt-6 mt-6 border-t border-ink-900/10 flex items-center justify-between">
            <span class="text-xs font-semibold text-ink-900">Product: Nexus AI Workspace</span>
            <a href="/nexus-ai" class="text-xs font-bold text-accent-600 hover:text-accent-700 inline-flex items-center gap-1 font-mono uppercase tracking-wider">
              Explore Nexus AI <span>→</span>
            </a>
          </div>
        </div>

        <!-- Problem & Solution 2: External -->
        <div class="border border-ink-900/15 bg-cream-50/70 p-8 rounded-sm shadow-sm flex flex-col justify-between vintage-border relative">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold text-blue-700 uppercase tracking-widest font-mono">02 / Outside the Company</span>
              <span class="px-2.5 py-0.5 rounded-full bg-blue-500/10 text-blue-800 text-[10px] font-mono font-bold uppercase">Credibility Gap</span>
            </div>
            <h3 class="font-serif text-2xl font-semibold text-ink-900 mb-3">
              Weak Online Presence & Lost Customers
            </h3>
            <p class="text-xs md:text-sm text-ink-600 leading-relaxed font-sans mb-6">
              Today's customers research your business online before deciding to call or visit. If all they find is an unverified social profile or a broken, slow website, you lose trust and they turn to your competitors.
            </p>
            <div class="border-t border-ink-900/10 pt-4 space-y-2">
              <div class="text-xs font-semibold text-ink-900 font-serif">How Aixentrix Solves It:</div>
              <p class="text-xs text-ink-700 font-sans leading-relaxed">
                <strong class="font-semibold text-ink-950">WebLabs</strong> builds high-speed, mobile-optimized websites equipped with custom domains, Google Local SEO, verified business schema, and 1-tap WhatsApp consultation triggers.
              </p>
            </div>
          </div>
          <div class="pt-6 mt-6 border-t border-ink-900/10 flex items-center justify-between">
            <span class="text-xs font-semibold text-ink-900">Service: WebLabs by Aixentrix</span>
            <a href="/weblabs" class="text-xs font-bold text-blue-700 hover:text-blue-800 inline-flex items-center gap-1 font-mono uppercase tracking-wider">
              Explore WebLabs <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Two Flagship Offerings Section -->
    <section id="products" class="max-w-5xl mx-auto px-6 mb-24 space-y-12">
      <div class="text-center mb-8">
        <div class="vintage-divider text-xs font-semibold uppercase tracking-[0.3em] mb-4 text-ink-500 font-sans">
          <span class="flourish text-base">✦</span>
          <span class="mx-3">Our Products & Services</span>
          <span class="flourish text-base">✦</span>
        </div>
        <h2 class="font-serif text-3xl md:text-4xl font-semibold text-ink-900">
          The Aixentrix Ecosystem
        </h2>
      </div>

      <!-- Offering 1: Nexus AI -->
      <div class="border border-ink-900/15 bg-cream-50 rounded-sm p-8 md:p-12 shadow-2xl vintage-border relative overflow-hidden flex flex-col md:flex-row items-center gap-10">
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-bold text-accent-600 uppercase tracking-widest font-mono">Workspace Intelligence</span>
            <span class="bg-accent-500/10 text-accent-700 text-[9px] px-1.5 py-0.5 rounded font-sans font-bold uppercase tracking-wider">Beta</span>
          </div>
          <h3 class="font-serif text-3xl md:text-4xl font-semibold text-ink-900 mb-4 leading-tight">
            Nexus AI: The Autonomous AI Chief of Staff
          </h3>
          <p class="text-sm text-ink-700 leading-relaxed font-sans mb-6">
            Nexus AI by Aixentrix unifies your email client, calendar schedules, task boards, team communication, and document directories into a single cognitive workspace. It acts as an active assistant that automates routine triaging, generates daily operational briefs, and preserves permanent institutional memory so nothing slips through the cracks.
          </p>
          <ul class="space-y-2 mb-6 text-xs text-ink-700 font-sans">
            <li class="flex items-center gap-2">
              <span class="text-accent-600 font-bold">✓</span>
              <span>Active Context Graphs that automatically connect emails, meetings, and project tickets</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-accent-600 font-bold">✓</span>
              <span>Automated employee handovers that retain institutional knowledge permanently</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-accent-600 font-bold">✓</span>
              <span>Clean, distraction-free vintage paper aesthetic designed for focused team execution</span>
            </li>
          </ul>
          <div class="flex items-center gap-4">
            <a 
              href="/nexus-ai" 
              class="px-6 py-2.5 rounded-full bg-ink-900 hover:bg-accent-950 text-cream-50 font-medium text-[11px] tracking-wider uppercase transition-all flex items-center gap-1.5"
            >
              Explore Nexus AI <span>→</span>
            </a>
            <a 
              href="/pricing" 
              class="text-xs font-semibold text-ink-900 hover:text-accent-700 transition-colors"
            >
              Pricing Details
            </a>
          </div>
        </div>

        <div class="w-full md:w-80 shrink-0 border border-ink-900/10 bg-white p-6 rounded-lg shadow-sm flex flex-col gap-4">
          <div class="flex items-center justify-between border-b border-ink-900/5 pb-2">
            <span class="text-xs font-bold text-ink-900">Workspace Architecture</span>
            <span class="px-2 py-0.5 rounded-full bg-accent-500/10 text-accent-700 text-[9px] font-semibold tracking-wider uppercase">Public Beta</span>
          </div>
          <div class="flex flex-col gap-2 text-xs text-ink-600 font-sans">
            <div class="flex justify-between">
              <span>Context Engine:</span>
              <strong class="text-ink-950">pgvector & Graph</strong>
            </div>
            <div class="flex justify-between">
              <span>Handover Engine:</span>
              <strong class="text-emerald-700">Automated Briefs</strong>
            </div>
            <div class="flex justify-between">
              <span>Customer Data Policy:</span>
              <strong class="text-ink-950">Zero Model Training</strong>
            </div>
            <div class="pt-2 border-t border-ink-900/5 text-[11px] text-ink-500 italic font-serif">
              "An active AI Chief of Staff designed for modern teams."
            </div>
          </div>
        </div>
      </div>

      <!-- Offering 2: WebLabs -->
      <div class="border border-ink-900/15 bg-cream-50 rounded-sm p-8 md:p-12 shadow-2xl vintage-border relative overflow-hidden flex flex-col md:flex-row items-center gap-10">
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-bold text-blue-700 uppercase tracking-widest font-mono">Web Engineering & Credibility</span>
            <span class="bg-blue-500/10 text-blue-800 text-[9px] px-1.5 py-0.5 rounded font-sans font-bold uppercase tracking-wider">Service Suite</span>
          </div>
          <h3 class="font-serif text-3xl md:text-4xl font-semibold text-ink-900 mb-4 leading-tight">
            WebLabs: Custom Websites That Establish Market Credibility
          </h3>
          <p class="text-sm text-ink-700 leading-relaxed font-sans mb-6">
            In today's digital economy, an unverified social profile or a broken, slow website destroys customer trust before you even speak. WebLabs builds high-performance, mobile-first websites tailored to your exact industry. We handle domain setup, security, local SEO indexing, and instant 1-tap WhatsApp consultation flows so customer searches convert directly into revenue.
          </p>
          <ul class="space-y-2 mb-6 text-xs text-ink-700 font-sans">
            <li class="flex items-center gap-2">
              <span class="text-blue-600 font-bold">✓</span>
              <span>100% Turnkey: custom domain, SSL security, fast edge CDN hosting, and Google indexing</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-blue-600 font-bold">✓</span>
              <span>Instant WhatsApp booking, click-to-call, and interactive service menus</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-blue-600 font-bold">✓</span>
              <span>Sub-second page loads engineered without slow, fragile WordPress plugins</span>
            </li>
          </ul>
          <div class="flex items-center gap-4">
            <a 
              href="/weblabs" 
              class="px-6 py-2.5 rounded-full bg-blue-900 hover:bg-blue-950 text-cream-50 font-medium text-[11px] tracking-wider uppercase transition-all flex items-center gap-1.5"
            >
              Explore WebLabs <span>→</span>
            </a>
            <a 
              href="/contact" 
              class="text-xs font-semibold text-ink-900 hover:text-accent-700 transition-colors"
            >
              Inquire About a Website
            </a>
          </div>
        </div>

        <div class="w-full md:w-80 shrink-0 border border-ink-900/10 bg-white p-6 rounded-lg shadow-sm flex flex-col gap-4">
          <div class="flex items-center justify-between border-b border-ink-900/5 pb-2">
            <span class="text-xs font-bold text-ink-900">WebLabs Performance</span>
            <span class="px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-700 text-[9px] font-semibold tracking-wider uppercase">Live Benchmarks</span>
          </div>
          <div class="flex flex-col gap-2 text-xs text-ink-600 font-sans">
            <div class="flex justify-between">
              <span>Mobile PageSpeed Score:</span>
              <strong class="text-emerald-600">98 / 100</strong>
            </div>
            <div class="flex justify-between">
              <span>Average Load Speed:</span>
              <strong class="text-emerald-600">&lt; 0.8 seconds</strong>
            </div>
            <div class="flex justify-between">
              <span>Turnkey Setup Time:</span>
              <strong class="text-ink-950">5–7 Days</strong>
            </div>
            <div class="pt-2 border-t border-ink-900/5 text-[11px] text-ink-500 italic font-serif">
              "Turns passive visitors into qualified phone calls and WhatsApp chats."
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Businesses Choose Aixentrix -->
    <section class="max-w-5xl mx-auto px-6 mb-24">
      <div class="text-center mb-12">
        <span class="text-xs font-bold text-accent-600 uppercase tracking-widest block mb-2 font-mono">Our Differentiators</span>
        <h2 class="font-serif text-3xl md:text-4xl font-semibold text-ink-900">
          Why Modern Businesses Choose Aixentrix
        </h2>
        <p class="text-xs md:text-sm text-ink-600 max-w-xl mx-auto mt-2 font-sans">
          We don't sell bloated templates or unmaintained code. We build active software infrastructure that accelerates your company.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="border border-ink-900/10 bg-cream-50/50 p-8 rounded-lg shadow-sm">
          <span class="text-xs font-bold text-accent-600 uppercase tracking-widest block mb-3 font-mono">01 / Architecture</span>
          <h3 class="font-serif text-xl font-semibold text-ink-900 mb-3">AI-First Engineering</h3>
          <p class="text-xs text-ink-600 leading-relaxed font-sans">
            From semantic vector search in Nexus AI to automated SEO pipelines in WebLabs, our products are engineered with cutting-edge AI foundations rather than superficial overlays.
          </p>
        </div>

        <div class="border border-ink-900/10 bg-cream-50/50 p-8 rounded-lg shadow-sm">
          <span class="text-xs font-bold text-accent-600 uppercase tracking-widest block mb-3 font-mono">02 / Accountability</span>
          <h3 class="font-serif text-xl font-semibold text-ink-900 mb-3">Direct Creator Partnership</h3>
          <p class="text-xs text-ink-600 leading-relaxed font-sans">
            No middleman account managers or endless agency layers. You partner directly with the software engineers responsible for your uptime, security, and digital execution.
          </p>
        </div>

        <div class="border border-ink-900/10 bg-cream-50/50 p-8 rounded-lg shadow-sm">
          <span class="text-xs font-bold text-accent-600 uppercase tracking-widest block mb-3 font-mono">03 / Authenticity</span>
          <h3 class="font-serif text-xl font-semibold text-ink-900 mb-3">Zero Fluff & Honest ROI</h3>
          <p class="text-xs text-ink-600 leading-relaxed font-sans">
            We don't rely on fabricated reviews or vanity metrics. We focus exclusively on measurable business results: reclaimed working hours inside your team and tangible customer conversions on your website.
          </p>
        </div>
      </div>
    </section>

    <!-- Nagpur Hub -->
    <section class="max-w-4xl mx-auto px-6 text-center border-t border-ink-900/10 pt-16">
      <h3 class="font-serif text-2xl font-semibold text-ink-900 mb-3">Headquartered in Nagpur, Serving Modern Teams Globally</h3>
      <p class="text-xs text-ink-600 leading-relaxed max-w-xl mx-auto font-sans">
        Aixentrix is founded in Nagpur, India, harnessing deep software engineering talent to build world-class AI agent workspaces and high-converting digital storefronts for forward-thinking organizations worldwide.
      </p>
    </section>
  </main>

  <Footer />
</Layout>

