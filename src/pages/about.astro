---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/landing/Navbar';
import { Footer } from '../components/landing/Footer';
import { Sparkles, Globe, MapPin, Mail, ArrowUpRight } from 'lucide-react';

const domain = "https://www.aixentrix.com";
const canonical = `${domain}/about`;

const seoTitle = "About Aixentrix — AI Software, Products & Digital Presence";
const seoDescription = "Learn about Aixentrix, Inc., the AI software company behind Nexus AI (the AI Chief of Staff) and WebLabs (bespoke website development). Based in Nagpur, India.";

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Aixentrix",
  "legalName": "Aixentrix, Inc.",
  "url": domain,
  "logo": `${domain}/logo.png`,
  "email": "info.aixentrix@gmail.com",
  "description": seoDescription,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Nagpur",
    "addressRegion": "Maharashtra",
    "addressCountry": "IN"
  },
  "sameAs": [
    "https://github.com/Sainathkotage/Nexus-Ai",
    "https://www.linkedin.com/in/sainathkotage/",
    "https://x.com/AixentrixNexus"
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": domain },
    { "@type": "ListItem", "position": 2, "name": "About", "item": canonical }
  ]
};
---

<Layout title={seoTitle} description={seoDescription} canonical={canonical} schemas={[orgSchema, breadcrumbSchema]}>
  <Navbar client:load />

  <main class="pt-32 pb-24 max-w-4xl mx-auto px-6 relative z-10 font-sans text-ink-900">
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-semibold text-ink-500 uppercase tracking-widest font-sans">
      <a href="/" class="hover:text-accent-600 transition-colors">Aixentrix</a>
      <span class="text-ink-300">/</span>
      <span class="text-ink-900 font-bold">About</span>
    </nav>

    <article class="bg-cream-50 rounded-sm border border-ink-900/15 shadow-2xl p-8 md:p-12 vintage-border relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-400/5 to-transparent pointer-events-none" />

      <header class="relative z-10 mb-12 text-center border-b border-ink-900/10 pb-8">
        <div class="vintage-divider text-xs font-semibold uppercase tracking-[0.3em] mb-4 text-ink-500 font-sans">
          <span class="flourish text-base">✦</span>
          <span class="mx-3">Company Profile</span>
          <span class="flourish text-base">✦</span>
        </div>

        <h1 class="font-serif text-4xl md:text-5xl font-medium text-ink-900 mb-6">
          About Aixentrix
        </h1>

        <p class="text-base text-ink-700 leading-relaxed max-w-2xl mx-auto font-serif italic">
          Aixentrix is an AI software company built to eliminate internal operational friction and external digital invisibility for modern businesses.
        </p>
      </header>

      <div class="relative z-10 prose prose-stone max-w-none text-sm text-ink-700 leading-relaxed space-y-8 font-sans">
        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">Who We Are</h2>
          <p>
            <strong>Aixentrix, Inc.</strong> is a technology software company headquartered in Nagpur, Maharashtra, India. We engineer intelligent software environments that think, remember, and execute—helping organizations transform fragmented data into unified, permanent institutional memory.
          </p>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">Our Two Core Offerings</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-4">
            <div class="p-6 bg-cream-100/70 border border-ink-900/10 rounded-sm">
              <div class="text-[10px] font-mono font-bold text-accent-700 uppercase tracking-wider mb-2">Software Product</div>
              <h3 class="font-serif text-xl font-semibold text-ink-900 mb-2">Nexus AI</h3>
              <p class="text-xs text-ink-600 mb-4">
                The AI Chief of Staff for modern teams. Retains organizational knowledge, automates employee handovers, manages commitments, and turns daily context into actionable intelligence.
              </p>
              <a href="/nexus-ai" class="text-xs font-semibold text-accent-700 hover:text-accent-800 inline-flex items-center gap-1 font-sans">
                Explore Nexus AI <span>→</span>
              </a>
            </div>

            <div class="p-6 bg-cream-100/70 border border-ink-900/10 rounded-sm">
              <div class="text-[10px] font-mono font-bold text-blue-800 uppercase tracking-wider mb-2">Engineering Service</div>
              <h3 class="font-serif text-xl font-semibold text-ink-900 mb-2">WebLabs</h3>
              <p class="text-xs text-ink-600 mb-4">
                Bespoke website development and complete digital presence for businesses. Turnkey custom design, edge hosting, local SEO, and instant WhatsApp inquiry capture.
              </p>
              <a href="/weblabs" class="text-xs font-semibold text-blue-700 hover:text-blue-800 inline-flex items-center gap-1 font-sans">
                Explore WebLabs <span>→</span>
              </a>
            </div>
          </div>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">Headquarters & Contact</h2>
          <div class="p-4 bg-cream-100/50 border border-ink-900/10 rounded-sm space-y-2 text-xs text-ink-700">
            <div class="flex items-center gap-2">
              <MapPin className="w-4 h-4 text-accent-600 shrink-0" />
              <span><strong>Headquarters:</strong> Nagpur, Maharashtra, India</span>
            </div>
            <div class="flex items-center gap-2">
              <Mail className="w-4 h-4 text-accent-600 shrink-0" />
              <span><strong>Inquiries:</strong> info.aixentrix@gmail.com</span>
            </div>
            <div class="flex items-center gap-2">
              <Globe className="w-4 h-4 text-accent-600 shrink-0" />
              <span><strong>Official Website:</strong> https://www.aixentrix.com</span>
            </div>
          </div>
        </section>

        <div class="pt-6 border-t border-ink-900/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/" class="text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            ← Back to Homepage
          </a>
          <a href="/contact" class="px-6 py-2.5 rounded-sm bg-ink-900 hover:bg-accent-600 text-cream-100 text-xs font-semibold uppercase tracking-wider transition-all">
            Get in Touch
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
