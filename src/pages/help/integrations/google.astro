---
import Layout from '../../../layouts/Layout.astro';
import { Navbar } from '../../../components/landing/Navbar';
import { Footer } from '../../../components/landing/Footer';
import { Mail, Calendar, ArrowRight, ArrowLeft, CheckCircle2, Shield } from 'lucide-react';

const domain = "https://www.aixentrix.com";
const canonical = `${domain}/help/integrations/google`;

const seoTitle = "Google Workspace Integration — Nexus AI Help Centre | Aixentrix";
const seoDescription = "How to connect Google Workspace (Gmail, Calendar, Drive) to Nexus AI with granular OAuth2 permissions and security controls.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": domain },
    { "@type": "ListItem", "position": 2, "name": "Help Centre", "item": `${domain}/help` },
    { "@type": "ListItem", "position": 3, "name": "Integrations", "item": `${domain}/help#integrations` },
    { "@type": "ListItem", "position": 4, "name": "Google Workspace", "item": canonical }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonical,
  "author": { "@type": "Organization", "name": "Aixentrix" },
  "publisher": { "@type": "Organization", "name": "Aixentrix", "url": domain }
};
---

<Layout title={seoTitle} description={seoDescription} canonical={canonical} schemas={[breadcrumbSchema, articleSchema]}>
  <Navbar client:load />

  <main class="pt-32 pb-24 max-w-4xl mx-auto px-6 relative z-10 font-sans text-ink-900">
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-semibold text-ink-500 uppercase tracking-widest">
      <a href="/" class="hover:text-accent-600 transition-colors">Aixentrix</a>
      <span class="text-ink-300">/</span>
      <a href="/help" class="hover:text-accent-600 transition-colors">Help Centre</a>
      <span class="text-ink-300">/</span>
      <span class="text-ink-500">Integrations</span>
      <span class="text-ink-300">/</span>
      <span class="text-ink-900 font-bold">Google Workspace</span>
    </nav>

    <article class="bg-cream-50 rounded-sm border border-ink-900/15 shadow-2xl p-8 md:p-12 vintage-border relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-400/5 to-transparent pointer-events-none" />

      <header class="relative z-10 mb-10 border-b border-ink-900/10 pb-8">
        <div class="vintage-divider text-xs font-semibold uppercase tracking-[0.3em] mb-4 text-ink-500">
          <span class="flourish text-base">✦</span>
          <span class="mx-3">Integration Guide</span>
          <span class="flourish text-base">✦</span>
        </div>
        <h1 class="font-serif text-3xl md:text-5xl font-medium text-ink-900 leading-tight mb-4">
          Google Workspace Integration Guide
        </h1>
        <p class="text-base text-ink-700 font-serif italic">
          Connect Gmail, Google Calendar, and Drive to feed your Chief of Staff context engine.
        </p>
      </header>

      <div class="relative z-10 prose prose-stone max-w-none text-sm text-ink-700 leading-relaxed space-y-8 font-sans">
        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">Overview of Permissions</h2>
          <p>
            Nexus AI requests minimal, read-only OAuth scopes needed to construct your context graph:
          </p>
          <ul class="list-disc pl-5 space-y-2 text-ink-700">
            <li><strong>Gmail (Read-Only):</strong> Indexes important customer and project threads. Promotional and social tabs are automatically ignored.</li>
            <li><strong>Google Calendar (Read-Only):</strong> Surfaces upcoming meetings to prepare contextual briefs and attendees dossiers.</li>
            <li><strong>Google Drive (Optional):</strong> Indexes shared team documents and specs you explicitly designate.</li>
          </ul>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">How to Connect</h2>
          <ol class="list-decimal pl-5 space-y-2">
            <li>Navigate to <strong>Settings → Integrations</strong> in your Nexus AI dashboard.</li>
            <li>Click <strong>Connect Google Workspace</strong>.</li>
            <li>Review the Google OAuth permission consent screen and authorize your corporate account.</li>
            <li>Select specific email labels or calendar categories to sync.</li>
          </ol>
        </section>

        <div class="pt-8 border-t border-ink-900/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/help" class="inline-flex items-center gap-2 text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            <ArrowLeft class="w-4 h-4" /> Help Centre
          </a>
          <a href="/help/integrations/slack" class="inline-flex items-center gap-2 text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            Slack Integration <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer client:load />
</Layout>
