---
import Layout from '../../../layouts/Layout.astro';
import { Navbar } from '../../../components/landing/Navbar';
import { Footer } from '../../../components/landing/Footer';
import { ShieldCheck, Lock, Key, Server, ArrowRight, ArrowLeft } from 'lucide-react';

const domain = "https://www.aixentrix.com";
const canonical = `${domain}/help/account/security`;

const seoTitle = "Security & Privacy Architecture — Nexus AI Help Centre | Aixentrix";
const seoDescription = "Learn about Nexus AI data privacy, encryption at rest and in transit, tenant isolation, and zero-training guarantees.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": domain },
    { "@type": "ListItem", "position": 2, "name": "Help Centre", "item": `${domain}/help` },
    { "@type": "ListItem", "position": 3, "name": "Account & Security", "item": `${domain}/help#account-security` },
    { "@type": "ListItem", "position": 4, "name": "Security & Privacy", "item": canonical }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonical,
  "author": { "@type": "Organization", "name": "Aixentrix" },
  "publisher": { "@type": "Organization", "name": "Aixentrix", "url": domain }
};
---

<Layout title={seoTitle} description={seoDescription} canonical={canonical} schemas={[breadcrumbSchema, articleSchema]}>
  <Navbar client:load />

  <main class="pt-32 pb-24 max-w-4xl mx-auto px-6 relative z-10 font-sans text-ink-900">
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-semibold text-ink-500 uppercase tracking-widest">
      <a href="/" class="hover:text-accent-600 transition-colors">Aixentrix</a>
      <span class="text-ink-300">/</span>
      <a href="/help" class="hover:text-accent-600 transition-colors">Help Centre</a>
      <span class="text-ink-300">/</span>
      <span class="text-ink-500">Account & Security</span>
      <span class="text-ink-300">/</span>
      <span class="text-ink-900 font-bold">Security & Privacy</span>
    </nav>

    <article class="bg-cream-50 rounded-sm border border-ink-900/15 shadow-2xl p-8 md:p-12 vintage-border relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-400/5 to-transparent pointer-events-none" />

      <header class="relative z-10 mb-10 border-b border-ink-900/10 pb-8">
        <div class="vintage-divider text-xs font-semibold uppercase tracking-[0.3em] mb-4 text-ink-500">
          <span class="flourish text-base">✦</span>
          <span class="mx-3">Security & Compliance</span>
          <span class="flourish text-base">✦</span>
        </div>
        <h1 class="font-serif text-3xl md:text-5xl font-medium text-ink-900 leading-tight mb-4">
          Security & Privacy Architecture
        </h1>
        <p class="text-base text-ink-700 font-serif italic">
          How Aixentrix protects customer data with end-to-end encryption, strict tenant isolation, and zero-model-training policies.
        </p>
      </header>

      <div class="relative z-10 prose prose-stone max-w-none text-sm text-ink-700 leading-relaxed space-y-8 font-sans">
        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">1. Zero Data Training Guarantee</h2>
          <p>
            <strong>Your company data is never used to train public or foundational artificial intelligence models.</strong> Nexus AI strictly utilizes enterprise API agreements where customer prompts, embeddings, and context payloads are explicitly excluded from model training datasets.
          </p>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">2. Encryption Standards</h2>
          <ul class="list-disc pl-5 space-y-2 text-ink-700">
            <li><strong>In Transit:</strong> All web traffic and API communications are enforced via TLS 1.3 with modern cipher suites.</li>
            <li><strong>At Rest:</strong> All stored data, database records, and vector embeddings are encrypted using AES-256 with managed KMS keys.</li>
          </ul>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">3. Multi-Tenant Isolation</h2>
          <p>
            Data isolation is enforced at the database layer via PostgreSQL Row-Level Security (RLS). Every query executed by Nexus AI is scoped strictly to the authenticated tenant's workspace ID, ensuring cross-tenant data contamination is architecturally impossible.
          </p>
        </section>

        <div class="pt-8 border-t border-ink-900/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/help" class="inline-flex items-center gap-2 text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            <ArrowLeft class="w-4 h-4" /> Help Centre
          </a>
          <a href="/help/account/settings" class="inline-flex items-center gap-2 text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            Account Settings <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer client:load />
</Layout>
