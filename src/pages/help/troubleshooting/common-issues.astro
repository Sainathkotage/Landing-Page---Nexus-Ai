---
import Layout from '../../../layouts/Layout.astro';
import { Navbar } from '../../../components/landing/Navbar';
import { Footer } from '../../../components/landing/Footer';
import { HelpCircle, AlertCircle, RefreshCw, ArrowRight, ArrowLeft } from 'lucide-react';

const domain = "https://www.aixentrix.com";
const canonical = `${domain}/help/troubleshooting/common-issues`;

const seoTitle = "Common Issues & Troubleshooting — Nexus AI Help Centre | Aixentrix";
const seoDescription = "Troubleshooting solutions for sync delays, search precision, integration errors, and permissions in Nexus AI.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": domain },
    { "@type": "ListItem", "position": 2, "name": "Help Centre", "item": `${domain}/help` },
    { "@type": "ListItem", "position": 3, "name": "Troubleshooting", "item": `${domain}/help#troubleshooting` },
    { "@type": "ListItem", "position": 4, "name": "Common Issues", "item": canonical }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why is my recently sent Slack message not showing up in search immediately?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nexus AI batches non-urgent channel messages and indexes them in 2 to 5-minute intervals to optimize embedding efficiency and rate limits. High-priority direct mentions and thread reactions are prioritized."
      }
    },
    {
      "@type": "Question",
      "name": "Why did a commitment not get detected?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nexus AI detects commitments with high confidence thresholds to avoid false alarms. If a vague phrase was used (e.g., 'maybe later'), it might be skipped. You can manually flag any message with the :memo: reaction to force commitment extraction."
      }
    },
    {
      "@type": "Question",
      "name": "How do I force a re-index of a connected data source?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Navigate to Settings → Integrations, locate the connected integration card, and click 'Resync Data'. Initial resyncs can take between 5 to 15 minutes depending on channel volume."
      }
    }
  ]
};
---

<Layout title={seoTitle} description={seoDescription} canonical={canonical} schemas={[breadcrumbSchema, faqSchema]}>
  <Navbar client:load />

  <main class="pt-32 pb-24 max-w-4xl mx-auto px-6 relative z-10 font-sans text-ink-900">
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-semibold text-ink-500 uppercase tracking-widest">
      <a href="/" class="hover:text-accent-600 transition-colors">Aixentrix</a>
      <span class="text-ink-300">/</span>
      <a href="/help" class="hover:text-accent-600 transition-colors">Help Centre</a>
      <span class="text-ink-300">/</span>
      <span class="text-ink-500">Troubleshooting</span>
      <span class="text-ink-300">/</span>
      <span class="text-ink-900 font-bold">Common Issues</span>
    </nav>

    <article class="bg-cream-50 rounded-sm border border-ink-900/15 shadow-2xl p-8 md:p-12 vintage-border relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-400/5 to-transparent pointer-events-none" />

      <header class="relative z-10 mb-10 border-b border-ink-900/10 pb-8">
        <div class="vintage-divider text-xs font-semibold uppercase tracking-[0.3em] mb-4 text-ink-500">
          <span class="flourish text-base">✦</span>
          <span class="mx-3">Troubleshooting Guide</span>
          <span class="flourish text-base">✦</span>
        </div>
        <h1 class="font-serif text-3xl md:text-5xl font-medium text-ink-900 leading-tight mb-4">
          Common Issues & Resolutions
        </h1>
        <p class="text-base text-ink-700 font-serif italic">
          Quick diagnostic steps for sync delays, search precision, and integration connectivity.
        </p>
      </header>

      <div class="relative z-10 prose prose-stone max-w-none text-sm text-ink-700 leading-relaxed space-y-8 font-sans">
        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">1. Sync Delays & Webhooks</h2>
          <div class="bg-cream-100/80 p-5 rounded-sm border border-ink-900/10">
            <h3 class="font-serif font-semibold text-ink-900 text-base mb-2">Issue: New messages take several minutes to appear in search.</h3>
            <p class="text-xs text-ink-700 mb-2">
              <strong>Cause:</strong> Nexus AI batches incoming messages across high-volume channels into semantic chunks before generating vector embeddings.
            </p>
            <p class="text-xs text-ink-700">
              <strong>Resolution:</strong> For immediate indexing of a critical thread, add a <code>:memo:</code> or <code>:pushpin:</code> emoji reaction to the message, which triggers an instantaneous high-priority webhook.
            </p>
          </div>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">2. Re-Authorizing Expired Tokens</h2>
          <div class="bg-cream-100/80 p-5 rounded-sm border border-ink-900/10">
            <h3 class="font-serif font-semibold text-ink-900 text-base mb-2">Issue: "Integration Disconnected" banner in dashboard.</h3>
            <p class="text-xs text-ink-700 mb-2">
              <strong>Cause:</strong> OAuth tokens from Google Workspace or Slack expire or are revoked during enterprise password rotations.
            </p>
            <p class="text-xs text-ink-700">
              <strong>Resolution:</strong> Visit <strong>Settings → Integrations</strong> and click <strong>Reconnect</strong> next to the affected service.
            </p>
          </div>
        </section>

        <div class="pt-8 border-t border-ink-900/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/help/troubleshooting/login" class="inline-flex items-center gap-2 text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            <ArrowLeft class="w-4 h-4" /> Login Support
          </a>
          <a href="/contact" class="inline-flex items-center gap-2 text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            Contact Support Team <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer client:load />
</Layout>
