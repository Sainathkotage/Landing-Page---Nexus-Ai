---
import Layout from '../../../layouts/Layout.astro';
import { Navbar } from '../../../components/landing/Navbar';
import { Footer } from '../../../components/landing/Footer';
import { CheckSquare, Clock, AlertTriangle, ArrowRight, ArrowLeft } from 'lucide-react';

const domain = "https://www.aixentrix.com";
const canonical = `${domain}/help/features/commitments`;

const seoTitle = "Automated Commitment Tracking — Nexus AI Help Centre | Aixentrix";
const seoDescription = "How Nexus AI detects, tracks, and manages action items and verbal promises made across team conversations.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": domain },
    { "@type": "ListItem", "position": 2, "name": "Help Centre", "item": `${domain}/help` },
    { "@type": "ListItem", "position": 3, "name": "Features", "item": `${domain}/help#core-features` },
    { "@type": "ListItem", "position": 4, "name": "Commitment Tracking", "item": canonical }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonical,
  "author": { "@type": "Organization", "name": "Aixentrix" },
  "publisher": { "@type": "Organization", "name": "Aixentrix", "url": domain }
};
---

<Layout title={seoTitle} description={seoDescription} canonical={canonical} schemas={[breadcrumbSchema, articleSchema]}>
  <Navbar client:load />

  <main class="pt-32 pb-24 max-w-4xl mx-auto px-6 relative z-10 font-sans text-ink-900">
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-semibold text-ink-500 uppercase tracking-widest">
      <a href="/" class="hover:text-accent-600 transition-colors">Aixentrix</a>
      <span class="text-ink-300">/</span>
      <a href="/help" class="hover:text-accent-600 transition-colors">Help Centre</a>
      <span class="text-ink-300">/</span>
      <span class="text-ink-500">Features</span>
      <span class="text-ink-300">/</span>
      <span class="text-ink-900 font-bold">Commitment Tracking</span>
    </nav>

    <article class="bg-cream-50 rounded-sm border border-ink-900/15 shadow-2xl p-8 md:p-12 vintage-border relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-400/5 to-transparent pointer-events-none" />

      <header class="relative z-10 mb-10 border-b border-ink-900/10 pb-8">
        <div class="vintage-divider text-xs font-semibold uppercase tracking-[0.3em] mb-4 text-ink-500">
          <span class="flourish text-base">✦</span>
          <span class="mx-3">Core Feature Guide</span>
          <span class="flourish text-base">✦</span>
        </div>
        <h1 class="font-serif text-3xl md:text-5xl font-medium text-ink-900 leading-tight mb-4">
          Automated Commitment Tracking
        </h1>
        <p class="text-base text-ink-700 font-serif italic">
          Never let an informal promise fall through the cracks between meetings and messaging apps.
        </p>
      </header>

      <div class="relative z-10 prose prose-stone max-w-none text-sm text-ink-700 leading-relaxed space-y-8 font-sans">
        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">What is a Commitment?</h2>
          <p>
            A commitment is any explicit or implicit promise made in a conversation—such as <em>"I will review the pull request by noon"</em> or <em>"We will follow up with the enterprise prospect on Tuesday"</em>. In traditional workflows, these commitments are forgotten unless manually entered into a project tracker.
          </p>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">How Nexus AI Tracks Commitments</h2>
          <p>
            Nexus AI uses natural language understanding (NLU) models specifically trained on workplace task semantics:
          </p>
          <ul class="list-disc pl-5 space-y-2 text-ink-700">
            <li><strong>Commitment Detection:</strong> Recognizes intent, assignee, requester, and inferred deadline.</li>
            <li><strong>Daily Digest:</strong> Shows your pending commitments in your morning Chief of Staff brief.</li>
            <li><strong>Resolution & Completion:</strong> Mark commitments as done directly in Nexus AI, or have them auto-resolved when related deliverables (e.g. merged PR or sent email) are detected.</li>
          </ul>
        </section>

        <div class="pt-8 border-t border-ink-900/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/help/features/team-intelligence" class="inline-flex items-center gap-2 text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            <ArrowLeft class="w-4 h-4" /> Team Intelligence
          </a>
          <a href="/help/account/security" class="inline-flex items-center gap-2 text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            Security & Privacy <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer client:load />
</Layout>
