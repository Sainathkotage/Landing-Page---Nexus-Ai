---
import Layout from '../../../layouts/Layout.astro';
import { Navbar } from '../../../components/landing/Navbar';
import { Footer } from '../../../components/landing/Footer';
import { Brain, Search, Database, Layers, ArrowRight, ArrowLeft } from 'lucide-react';

const domain = "https://www.aixentrix.com";
const canonical = `${domain}/help/features/organizational-memory`;

const seoTitle = "How Organizational Memory Works — Nexus AI Help Centre | Aixentrix";
const seoDescription = "Learn how Nexus AI uses context graphs and vector embeddings to capture, index, and retrieve institutional knowledge across your organization.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": domain },
    { "@type": "ListItem", "position": 2, "name": "Help Centre", "item": `${domain}/help` },
    { "@type": "ListItem", "position": 3, "name": "Features", "item": `${domain}/help#core-features` },
    { "@type": "ListItem", "position": 4, "name": "Organizational Memory", "item": canonical }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonical,
  "author": { "@type": "Organization", "name": "Aixentrix" },
  "publisher": { "@type": "Organization", "name": "Aixentrix", "url": domain }
};
---

<Layout title={seoTitle} description={seoDescription} canonical={canonical} schemas={[breadcrumbSchema, articleSchema]}>
  <Navbar client:load />

  <main class="pt-32 pb-24 max-w-4xl mx-auto px-6 relative z-10 font-sans text-ink-900">
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-semibold text-ink-500 uppercase tracking-widest">
      <a href="/" class="hover:text-accent-600 transition-colors">Aixentrix</a>
      <span class="text-ink-300">/</span>
      <a href="/help" class="hover:text-accent-600 transition-colors">Help Centre</a>
      <span class="text-ink-300">/</span>
      <span class="text-ink-500">Features</span>
      <span class="text-ink-300">/</span>
      <span class="text-ink-900 font-bold">Organizational Memory</span>
    </nav>

    <article class="bg-cream-50 rounded-sm border border-ink-900/15 shadow-2xl p-8 md:p-12 vintage-border relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-400/5 to-transparent pointer-events-none" />

      <header class="relative z-10 mb-10 border-b border-ink-900/10 pb-8">
        <div class="vintage-divider text-xs font-semibold uppercase tracking-[0.3em] mb-4 text-ink-500">
          <span class="flourish text-base">✦</span>
          <span class="mx-3">Core Feature Guide</span>
          <span class="flourish text-base">✦</span>
        </div>
        <h1 class="font-serif text-3xl md:text-5xl font-medium text-ink-900 leading-tight mb-4">
          Using Organizational Memory
        </h1>
        <p class="text-base text-ink-700 font-serif italic">
          Turn scattered emails, chat messages, and document comments into a unified, queryable company knowledge graph.
        </p>
      </header>

      <div class="relative z-10 prose prose-stone max-w-none text-sm text-ink-700 leading-relaxed space-y-8 font-sans">
        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">What is the Organizational Memory Engine?</h2>
          <p>
            In typical companies, institutional knowledge decays rapidly. Important technical decisions, customer requirements, and product pivots occur in ad-hoc Slack threads or meeting calls, rarely making it into formal documentation.
          </p>
          <p>
            Nexus AI acts as an automated custodian. It indexes conversations across permitted channels, extracts the underlying reasoning, identifies key decision makers, and builds a multidimensional vector graph that stays perpetually current.
          </p>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">How to Query Organizational Memory</h2>
          <p>
            You can query organizational memory using natural language from the web dashboard or directly in Slack:
          </p>
          <div class="bg-cream-100/80 p-5 rounded-sm border border-ink-900/10 space-y-3">
            <div>
              <span class="text-xs font-mono uppercase tracking-wider text-accent-800 font-bold">Query:</span>
              <p class="text-sm font-serif italic text-ink-900 mt-1">"Why did we pause the European enterprise rollout last month?"</p>
            </div>
            <div class="border-t border-ink-900/10 pt-2">
              <span class="text-xs font-mono uppercase tracking-wider text-ink-500 font-bold">Nexus AI Response:</span>
              <p class="text-xs text-ink-700 mt-1">
                The EU rollout was paused on August 14 following legal review of GDPR data residency compliance for multi-region clusters (discussed in #product-legal by Sarah and David). The revised timeline targets October once Frankfurt servers are provisioned.
              </p>
            </div>
          </div>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">Source Transparency & Citations</h2>
          <p>
            Every single answer generated by Nexus AI includes source chips. Clicking a citation opens the exact Slack thread, Gmail message, or document paragraph where the information originated, preventing hallucination and enabling fast verification.
          </p>
        </section>

        <div class="pt-8 border-t border-ink-900/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/help" class="inline-flex items-center gap-2 text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            <ArrowLeft class="w-4 h-4" /> Help Centre
          </a>
          <a href="/help/features/employee-handover" class="inline-flex items-center gap-2 text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            AI Employee Handover <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer client:load />
</Layout>
