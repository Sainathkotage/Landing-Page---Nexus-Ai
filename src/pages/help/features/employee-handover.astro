---
import Layout from '../../../layouts/Layout.astro';
import { Navbar } from '../../../components/landing/Navbar';
import { Footer } from '../../../components/landing/Footer';
import { UserCheck, FileText, ArrowRight, ArrowLeft, ShieldAlert } from 'lucide-react';

const domain = "https://www.aixentrix.com";
const canonical = `${domain}/help/features/employee-handover`;

const seoTitle = "AI Employee Handover Guide — Nexus AI Help Centre | Aixentrix";
const seoDescription = "Step-by-step guide to generating automated employee handover documents, retaining project context, and streamlining offboarding with Nexus AI.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": domain },
    { "@type": "ListItem", "position": 2, "name": "Help Centre", "item": `${domain}/help` },
    { "@type": "ListItem", "position": 3, "name": "Features", "item": `${domain}/help#core-features` },
    { "@type": "ListItem", "position": 4, "name": "Employee Handover", "item": canonical }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonical,
  "author": { "@type": "Organization", "name": "Aixentrix" },
  "publisher": { "@type": "Organization", "name": "Aixentrix", "url": domain }
};
---

<Layout title={seoTitle} description={seoDescription} canonical={canonical} schemas={[breadcrumbSchema, articleSchema]}>
  <Navbar client:load />

  <main class="pt-32 pb-24 max-w-4xl mx-auto px-6 relative z-10 font-sans text-ink-900">
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-semibold text-ink-500 uppercase tracking-widest">
      <a href="/" class="hover:text-accent-600 transition-colors">Aixentrix</a>
      <span class="text-ink-300">/</span>
      <a href="/help" class="hover:text-accent-600 transition-colors">Help Centre</a>
      <span class="text-ink-300">/</span>
      <span class="text-ink-500">Features</span>
      <span class="text-ink-300">/</span>
      <span class="text-ink-900 font-bold">Employee Handover</span>
    </nav>

    <article class="bg-cream-50 rounded-sm border border-ink-900/15 shadow-2xl p-8 md:p-12 vintage-border relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-400/5 to-transparent pointer-events-none" />

      <header class="relative z-10 mb-10 border-b border-ink-900/10 pb-8">
        <div class="vintage-divider text-xs font-semibold uppercase tracking-[0.3em] mb-4 text-ink-500">
          <span class="flourish text-base">✦</span>
          <span class="mx-3">Core Feature Guide</span>
          <span class="flourish text-base">✦</span>
        </div>
        <h1 class="font-serif text-3xl md:text-5xl font-medium text-ink-900 leading-tight mb-4">
          Automated AI Employee Handover
        </h1>
        <p class="text-base text-ink-700 font-serif italic">
          How to generate structured handover dossiers, preserve institutional knowledge, and onboard successors without friction.
        </p>
      </header>

      <div class="relative z-10 prose prose-stone max-w-none text-sm text-ink-700 leading-relaxed space-y-8 font-sans">
        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">The Problem with Manual Handovers</h2>
          <p>
            When an employee transitions or leaves an organization, teams traditionally scramble to conduct exit interviews and write manual handover documents. In practice, departing employees rarely remember every active thread, uncommitted promise, vendor contact, or operational nuance.
          </p>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">How to Generate a Handover Brief</h2>
          <ol class="list-decimal pl-5 space-y-3">
            <li>
              <strong>Initiate Handover:</strong> In the Nexus AI dashboard, navigate to <strong>Handover & Transitions</strong> and select the team member who is departing or transitioning roles.
            </li>
            <li>
              <strong>Select Timeframe & Scope:</strong> Choose the relevant evaluation window (e.g., past 90 days) and specify connected project channels.
            </li>
            <li>
              <strong>Review the Synthesized Dossier:</strong> Nexus AI automatically compiles:
              <ul class="list-disc pl-5 mt-2 space-y-1 text-xs">
                <li>All outstanding commitments and deliverables assigned to or owned by the individual.</li>
                <li>Key external vendor, client, and internal stakeholder relationships.</li>
                <li>Frequently accessed documents, repositories, and architectural references.</li>
                <li>Crucial unresolved discussions that require successor ownership.</li>
              </ul>
            </li>
            <li>
              <strong>Export & Assign:</strong> Export the dossier as a Markdown or PDF document, or reassign the open commitments directly to the successor within Nexus AI.
            </li>
          </ol>
        </section>

        <div class="pt-8 border-t border-ink-900/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/help/features/organizational-memory" class="inline-flex items-center gap-2 text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            <ArrowLeft class="w-4 h-4" /> Organizational Memory
          </a>
          <a href="/help/features/team-intelligence" class="inline-flex items-center gap-2 text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            Team Intelligence <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer client:load />
</Layout>
