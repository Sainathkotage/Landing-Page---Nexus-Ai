---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/landing/Navbar';
import { Footer } from '../../components/landing/Footer';
import { Lock, ShieldCheck, Database, KeyRound, Check, ArrowUpRight } from 'lucide-react';

const domain = "https://www.aixentrix.com";
const canonical = `${domain}/nexus-ai/security`;

const seoTitle = "Nexus AI Security & Data Privacy | Built by Aixentrix";
const seoDescription = "Learn about Nexus AI's enterprise security architecture: zero training on customer data, TLS 1.3 encryption, AES-256 at rest, and strict row-level security.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": domain },
    { "@type": "ListItem", "position": 2, "name": "Nexus AI", "item": `${domain}/nexus-ai` },
    { "@type": "ListItem", "position": 3, "name": "Security", "item": canonical }
  ]
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": seoTitle,
  "description": seoDescription,
  "url": canonical,
  "publisher": { "@type": "Organization", "name": "Aixentrix", "url": domain }
};
---

<Layout title={seoTitle} description={seoDescription} canonical={canonical} schemas={[breadcrumbSchema, webPageSchema]}>
  <Navbar client:load />

  <main class="pt-32 pb-24 max-w-4xl mx-auto px-6 relative z-10 font-sans text-ink-900">
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-semibold text-ink-500 uppercase tracking-widest font-sans">
      <a href="/" class="hover:text-accent-600 transition-colors">Aixentrix</a>
      <span class="text-ink-300">/</span>
      <a href="/nexus-ai" class="hover:text-accent-600 transition-colors">Nexus AI</a>
      <span class="text-ink-300">/</span>
      <span class="text-ink-900 font-bold">Security</span>
    </nav>

    <article class="bg-cream-50 rounded-sm border border-ink-900/15 shadow-2xl p-8 md:p-12 vintage-border relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-400/5 to-transparent pointer-events-none" />

      <header class="relative z-10 mb-12 text-center border-b border-ink-900/10 pb-8">
        <div class="vintage-divider text-xs font-semibold uppercase tracking-[0.3em] mb-4 text-ink-500">
          <span class="flourish text-base">✦</span>
          <span class="mx-3">Trust & Infrastructure</span>
          <span class="flourish text-base">✦</span>
        </div>
        <h1 class="font-serif text-4xl md:text-5xl font-medium text-ink-900 leading-tight mb-6">
          Security & Data Privacy
        </h1>
        <p class="text-base text-ink-700 leading-relaxed max-w-2xl mx-auto font-serif italic">
          How Nexus AI by Aixentrix safeguards corporate communication, customer records, and internal context graphs.
        </p>
      </header>

      <div class="relative z-10 prose prose-stone max-w-none text-sm text-ink-700 leading-relaxed space-y-8 font-sans">
        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">Our Core Security Principles</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-4">
            <div class="p-5 bg-cream-100/70 border border-ink-900/10 rounded-sm">
              <strong class="text-sm font-serif font-semibold text-ink-900 block mb-1">Zero Model Training</strong>
              <p class="text-xs text-ink-600">Your documents, messages, and email threads are strictly processed for context retrieval. We never use customer data to train public foundation models.</p>
            </div>
            <div class="p-5 bg-cream-100/70 border border-ink-900/10 rounded-sm">
              <strong class="text-sm font-serif font-semibold text-ink-900 block mb-1">Enterprise Encryption</strong>
              <p class="text-xs text-ink-600">All data in transit is encrypted using modern TLS 1.3 protocols. All vectorized embeddings and relational databases are encrypted at rest with AES-256.</p>
            </div>
            <div class="p-5 bg-cream-100/70 border border-ink-900/10 rounded-sm">
              <strong class="text-sm font-serif font-semibold text-ink-900 block mb-1">PostgreSQL Row-Level Security</strong>
              <p class="text-xs text-ink-600">Strict cryptographic tenant isolation guarantees that no team or user can ever access or query another organization's context vectors.</p>
            </div>
            <div class="p-5 bg-cream-100/70 border border-ink-900/10 rounded-sm">
              <strong class="text-sm font-serif font-semibold text-ink-900 block mb-1">Granular Scopes & Revocation</strong>
              <p class="text-xs text-ink-600">OAuth integrations only request minimum required read scopes, and tokens can be revoked instantly at any time from your admin settings.</p>
            </div>
          </div>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">Security Architecture FAQ</h2>
          <div class="space-y-3">
            <div>
              <strong class="text-sm font-semibold text-ink-900 block">Where is my data hosted?</strong>
              <p class="text-xs text-ink-600">Nexus AI infrastructure is hosted in enterprise-grade AWS and Supabase data centers with redundant backups, DDoS protection, and automated failover.</p>
            </div>
            <div>
              <strong class="text-sm font-semibold text-ink-900 block">What happens if we delete our account?</strong>
              <p class="text-xs text-ink-600">Upon account termination, all indexed vectors, embeddings, and cached messages are permanently purged from our database systems within 30 days.</p>
            </div>
          </div>
        </section>

        <div class="pt-6 border-t border-ink-900/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/nexus-ai" class="text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            ← Back to Nexus AI
          </a>
          <a href="mailto:security@aixentrix.com" class="text-xs font-semibold text-ink-600 hover:text-accent-700">
            Contact Security Team: security@aixentrix.com
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
