---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/landing/Navbar';
import { Footer } from '../../components/landing/Footer';
import { Sparkles, ArrowUpRight, ShieldCheck, Heart, Users, Target } from 'lucide-react';

const domain = "https://www.aixentrix.com";
const canonical = `${domain}/nexus-ai/about`;

const seoTitle = "About Nexus AI | Built by Aixentrix";
const seoDescription = "Learn about Nexus AI, the AI Chief of Staff engineered by Aixentrix. Discover our product philosophy, why we built it, and our vision for organizational memory.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": domain },
    { "@type": "ListItem", "position": 2, "name": "Nexus AI", "item": `${domain}/nexus-ai` },
    { "@type": "ListItem", "position": 3, "name": "About", "item": canonical }
  ]
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": seoTitle,
  "description": seoDescription,
  "url": canonical,
  "publisher": {
    "@type": "Organization",
    "name": "Aixentrix",
    "url": domain
  }
};
---

<Layout title={seoTitle} description={seoDescription} canonical={canonical} schemas={[breadcrumbSchema, webPageSchema]}>
  <Navbar client:load />

  <main class="pt-32 pb-24 max-w-4xl mx-auto px-6 relative z-10 font-sans text-ink-900">
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-semibold text-ink-500 uppercase tracking-widest font-sans">
      <a href="/" class="hover:text-accent-600 transition-colors">Aixentrix</a>
      <span class="text-ink-300">/</span>
      <a href="/nexus-ai" class="hover:text-accent-600 transition-colors">Nexus AI</a>
      <span class="text-ink-300">/</span>
      <span class="text-ink-900 font-bold">About</span>
    </nav>

    <article class="bg-cream-50 rounded-sm border border-ink-900/15 shadow-2xl p-8 md:p-12 vintage-border relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-400/5 to-transparent pointer-events-none" />

      <header class="relative z-10 mb-12 text-center border-b border-ink-900/10 pb-8">
        <div class="vintage-divider text-xs font-semibold uppercase tracking-[0.3em] mb-4 text-ink-500">
          <span class="flourish text-base">✦</span>
          <span class="mx-3">Product Philosophy</span>
          <span class="flourish text-base">✦</span>
        </div>
        <h1 class="font-serif text-4xl md:text-5xl font-medium text-ink-900 leading-tight mb-6">
          About Nexus AI
        </h1>
        <p class="text-base text-ink-700 leading-relaxed max-w-2xl mx-auto font-serif italic">
          Nexus AI is an AI Chief of Staff developed by Aixentrix to solve the silent crisis of modern knowledge work: organizational context loss.
        </p>
      </header>

      <div class="relative z-10 prose prose-stone max-w-none text-sm text-ink-700 leading-relaxed space-y-8 font-sans">
        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">The Problem We Are Solving</h2>
          <p>
            In every modern company, thousands of critical decisions, architectural debates, and client commitments occur daily across Slack threads, Google Docs, meeting transcripts, and email chains.
          </p>
          <p>
            When an employee resigns, transfers teams, or simply takes sick leave, that institutional knowledge vanishes. Teams waste countless hours asking: <em>"Why did we make this choice?"</em>, <em>"Who owns this vendor relationship?"</em>, or <em>"What commitments were promised to this client?"</em>
          </p>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">Our Product Philosophy: Active Over Passive</h2>
          <p>
            Traditional workplace software like Notion or Confluence relies on humans manually documenting their work. But in fast-moving teams, documentation is always deprioritized in favor of shipping.
          </p>
          <p>
            <strong>Nexus AI</strong> flips this paradigm. Instead of requiring manual updates, Nexus AI operates as an active AI Chief of Staff. It observes project activity across your tools in the background, continuously correlates context, and updates the organizational brain automatically.
          </p>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">Who Built Nexus AI?</h2>
          <p>
            Nexus AI is engineered by <strong>Aixentrix, Inc.</strong>, an AI technology software company headquartered in Nagpur, Maharashtra, India. Aixentrix builds intelligent software environments that think, remember, and execute—bridging the gap between internal operations and external digital authority.
          </p>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">Current Development Status</h2>
          <p>
            Nexus AI is currently in <strong>free public beta</strong>. We are working closely with early-adopter teams to refine our context indexing engine, offboarding workflows, and commitment tracking algorithms before General Availability (GA).
          </p>
        </section>

        <div class="pt-6 border-t border-ink-900/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/nexus-ai" class="text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            ← Back to Nexus AI Overview
          </a>
          <a href="https://app.aixentrix.com/?auth=signup" class="px-6 py-2.5 rounded-sm bg-ink-900 hover:bg-accent-600 text-cream-100 text-xs font-semibold uppercase tracking-wider transition-all">
            Join the Free Beta
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
