---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/landing/Navbar';
import { Footer } from '../../components/landing/Footer';
import { RefreshCw, Users, FileText, CheckSquare, ArrowUpRight } from 'lucide-react';

const domain = "https://www.aixentrix.com";
const canonical = `${domain}/nexus-ai/employee-handover`;

const seoTitle = "AI Employee Handover | Nexus AI by Aixentrix";
const seoDescription = "Learn how Nexus AI can help teams structure employee handovers and preserve important organizational context during transitions.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": domain },
    { "@type": "ListItem", "position": 2, "name": "Nexus AI", "item": `${domain}/nexus-ai` },
    { "@type": "ListItem", "position": 3, "name": "Employee Handover", "item": canonical }
  ]
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": seoTitle,
  "description": seoDescription,
  "url": canonical,
  "publisher": { "@type": "Organization", "name": "Aixentrix", "url": domain }
};
---

<Layout title={seoTitle} description={seoDescription} canonical={canonical} schemas={[breadcrumbSchema, webPageSchema]}>
  <Navbar client:load />

  <main class="pt-32 pb-24 max-w-4xl mx-auto px-6 relative z-10 font-sans text-ink-900">
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-semibold text-ink-500 uppercase tracking-widest font-sans">
      <a href="/" class="hover:text-accent-600 transition-colors">Aixentrix</a>
      <span class="text-ink-300">/</span>
      <a href="/nexus-ai" class="hover:text-accent-600 transition-colors">Nexus AI</a>
      <span class="text-ink-300">/</span>
      <span class="text-ink-900 font-bold">Employee Handover</span>
    </nav>

    <article class="bg-cream-50 rounded-sm border border-ink-900/15 shadow-2xl p-8 md:p-12 vintage-border relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-400/5 to-transparent pointer-events-none" />

      <header class="relative z-10 mb-12 text-center border-b border-ink-900/10 pb-8">
        <div class="vintage-divider text-xs font-semibold uppercase tracking-[0.3em] mb-4 text-ink-500">
          <span class="flourish text-base">✦</span>
          <span class="mx-3">Automated Offboarding</span>
          <span class="flourish text-base">✦</span>
        </div>
        <h1 class="font-serif text-4xl md:text-5xl font-medium text-ink-900 leading-tight mb-6">
          AI Employee Handover
        </h1>
        <p class="text-base text-ink-700 leading-relaxed max-w-2xl mx-auto font-serif italic">
          How Nexus AI by Aixentrix automates employee transition briefs, preventing tribal knowledge loss when team members move or exit.
        </p>
      </header>

      <div class="relative z-10 prose prose-stone max-w-none text-sm text-ink-700 leading-relaxed space-y-8 font-sans">
        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">The Problem with Traditional Handovers</h2>
          <p>
            When an employee gives two weeks' notice, chaos typically ensues. Managers ask for a handover document, but departing workers are already checked out mentally. What gets produced is usually a hurried, incomplete bullet list that leaves successors guessing.
          </p>
          <p>
            Important vendor accounts, ongoing client promises, key contacts, and unfinished bug fixes fall through the cracks, costing organizations thousands of dollars and months of lost velocity.
          </p>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">How Nexus AI Automates Handover Briefs</h2>
          <p>
            Nexus AI eliminates the panic of offboarding. Because it continuously indexes project activity, it can instantly compile a comprehensive, zero-loss transition package in minutes:
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-6">
            <div class="p-4 bg-cream-100/70 border border-ink-900/10 rounded-sm">
              <h3 class="font-serif text-sm font-semibold text-ink-900 mb-1">Open Commitments & Tasks</h3>
              <p class="text-xs text-ink-600">Extracts all unfinished deliverables, promises made in email/chat, and active deadlines assigned to the departing worker.</p>
            </div>
            <div class="p-4 bg-cream-100/70 border border-ink-900/10 rounded-sm">
              <h3 class="font-serif text-sm font-semibold text-ink-900 mb-1">Stakeholder & Vendor Map</h3>
              <p class="text-xs text-ink-600">Identifies external clients, partners, and internal colleagues the person collaborated with most frequently.</p>
            </div>
            <div class="p-4 bg-cream-100/70 border border-ink-900/10 rounded-sm">
              <h3 class="font-serif text-sm font-semibold text-ink-900 mb-1">File & Repository Ownership</h3>
              <p class="text-xs text-ink-600">Catalogs all shared drives, private documents, GitHub repos, and credentials requiring permission reassignment.</p>
            </div>
            <div class="p-4 bg-cream-100/70 border border-ink-900/10 rounded-sm">
              <h3 class="font-serif text-sm font-semibold text-ink-900 mb-1">Successor Onboarding Brief</h3>
              <p class="text-xs text-ink-600">Auto-generates a personalized onboarding dossier for whoever takes over the role, cutting ramp-up time by 70%.</p>
            </div>
          </div>
        </section>

        <div class="pt-6 border-t border-ink-900/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/nexus-ai" class="text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            ← Back to Nexus AI
          </a>
          <a href="https://app.aixentrix.com/?auth=signup" class="px-6 py-2.5 rounded-sm bg-ink-900 hover:bg-accent-600 text-cream-100 text-xs font-semibold uppercase tracking-wider transition-all">
            Join the Free Beta
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
