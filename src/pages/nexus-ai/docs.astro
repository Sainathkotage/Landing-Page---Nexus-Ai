---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/landing/Navbar';
import { Footer } from '../../components/landing/Footer';
import { BookOpen, Sparkles, KeyRound, Terminal, ArrowUpRight } from 'lucide-react';

const domain = "https://www.aixentrix.com";
const canonical = `${domain}/nexus-ai/docs`;

const seoTitle = "Nexus AI Documentation & Getting Started Guide | Aixentrix";
const seoDescription = "Official documentation for Nexus AI by Aixentrix: setup instructions, connecting channels, configuring organizational memory, and keyboard shortcuts.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": domain },
    { "@type": "ListItem", "position": 2, "name": "Nexus AI", "item": `${domain}/nexus-ai` },
    { "@type": "ListItem", "position": 3, "name": "Docs", "item": canonical }
  ]
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": seoTitle,
  "description": seoDescription,
  "url": canonical,
  "publisher": { "@type": "Organization", "name": "Aixentrix", "url": domain }
};
---

<Layout title={seoTitle} description={seoDescription} canonical={canonical} schemas={[breadcrumbSchema, webPageSchema]}>
  <Navbar client:load />

  <main class="pt-32 pb-24 max-w-4xl mx-auto px-6 relative z-10 font-sans text-ink-900">
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-semibold text-ink-500 uppercase tracking-widest font-sans">
      <a href="/" class="hover:text-accent-600 transition-colors">Aixentrix</a>
      <span class="text-ink-300">/</span>
      <a href="/nexus-ai" class="hover:text-accent-600 transition-colors">Nexus AI</a>
      <span class="text-ink-300">/</span>
      <span class="text-ink-900 font-bold">Docs</span>
    </nav>

    <article class="bg-cream-50 rounded-sm border border-ink-900/15 shadow-2xl p-8 md:p-12 vintage-border relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-400/5 to-transparent pointer-events-none" />

      <header class="relative z-10 mb-12 text-center border-b border-ink-900/10 pb-8">
        <div class="vintage-divider text-xs font-semibold uppercase tracking-[0.3em] mb-4 text-ink-500">
          <span class="flourish text-base">✦</span>
          <span class="mx-3">Guides & References</span>
          <span class="flourish text-base">✦</span>
        </div>
        <h1 class="font-serif text-4xl md:text-5xl font-medium text-ink-900 leading-tight mb-6">
          Nexus AI Documentation
        </h1>
        <p class="text-base text-ink-700 leading-relaxed max-w-2xl mx-auto font-serif italic">
          Everything you need to set up your team's AI Chief of Staff and configure organizational memory.
        </p>
      </header>

      <div class="relative z-10 prose prose-stone max-w-none text-sm text-ink-700 leading-relaxed space-y-8 font-sans">
        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">1. Quick Start Guide</h2>
          <p>
            Getting your team started with Nexus AI takes less than three minutes:
          </p>
          <ol class="list-decimal pl-5 space-y-2 text-xs text-ink-700">
            <li><strong>Create an account:</strong> Visit <a href="https://app.aixentrix.com/?auth=signup" class="text-accent-700 font-semibold underline">app.aixentrix.com</a> to create your organization workspace.</li>
            <li><strong>Connect channels:</strong> Authorize your team's primary communication tools (Google Workspace or Slack) from the Integrations panel.</li>
            <li><strong>Initial context indexing:</strong> Nexus AI begins building your private context graph. Historical messages are processed in the background within 24 hours.</li>
            <li><strong>Invite teammates:</strong> Add team members to give them access to semantic query search and automated meeting memos.</li>
          </ol>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">2. Core Concepts</h2>
          <div class="space-y-3">
            <div class="p-4 bg-cream-100/70 border border-ink-900/10 rounded-sm">
              <strong class="text-sm font-semibold text-ink-900 block font-serif">Context Graph:</strong>
              <span class="text-xs text-ink-600">The relational map linking people, decisions, code commits, and documents together across your organization.</span>
            </div>
            <div class="p-4 bg-cream-100/70 border border-ink-900/10 rounded-sm">
              <strong class="text-sm font-semibold text-ink-900 block font-serif">Handover Brief:</strong>
              <span class="text-xs text-ink-600">An auto-generated dossier capturing open tasks, key contacts, and document ownership for offboarding employees.</span>
            </div>
            <div class="p-4 bg-cream-100/70 border border-ink-900/10 rounded-sm">
              <strong class="text-sm font-semibold text-ink-900 block font-serif">Commitment Tracking:</strong>
              <span class="text-xs text-ink-600">Background routines that detect deliverables promised in emails and chats to prevent missed deadlines.</span>
            </div>
          </div>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">3. Keyboard Shortcuts</h2>
          <p>Nexus AI is designed for velocity with keyboard-first navigation:</p>
          <div class="grid grid-cols-2 gap-3 text-xs">
            <div class="p-3 bg-cream-100/50 border border-ink-900/10 flex justify-between"><code class="font-mono bg-cream-200 px-1.5 py-0.5 rounded">Cmd + K</code> <span>Global Command Palette</span></div>
            <div class="p-3 bg-cream-100/50 border border-ink-900/10 flex justify-between"><code class="font-mono bg-cream-200 px-1.5 py-0.5 rounded">Cmd + /</code> <span>Ask AI Chief of Staff</span></div>
            <div class="p-3 bg-cream-100/50 border border-ink-900/10 flex justify-between"><code class="font-mono bg-cream-200 px-1.5 py-0.5 rounded">Cmd + H</code> <span>Generate Handover Memo</span></div>
            <div class="p-3 bg-cream-100/50 border border-ink-900/10 flex justify-between"><code class="font-mono bg-cream-200 px-1.5 py-0.5 rounded">Cmd + M</code> <span>View Meeting Memos</span></div>
          </div>
        </section>

        <div class="pt-6 border-t border-ink-900/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/nexus-ai" class="text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            ← Back to Nexus AI
          </a>
          <a href="https://app.aixentrix.com/?auth=signup" class="px-6 py-2.5 rounded-sm bg-ink-900 hover:bg-accent-600 text-cream-100 text-xs font-semibold uppercase tracking-wider transition-all">
            Launch Nexus AI Workspace
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
