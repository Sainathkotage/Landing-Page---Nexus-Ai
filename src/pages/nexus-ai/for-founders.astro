---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/landing/Navbar';
import { Footer } from '../../components/landing/Footer';
import { Compass, CheckSquare, Eye, ShieldCheck, ArrowRight, ArrowLeft } from 'lucide-react';

const domain = "https://www.aixentrix.com";
const canonical = `${domain}/nexus-ai/for-founders`;

const seoTitle = "Nexus AI for Founders — The AI Chief of Staff | Aixentrix";
const seoDescription = "How startup founders and executives use Nexus AI to track commitments, maintain strategic clarity, eliminate blind spots, and run operations without micromanagement.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": domain },
    { "@type": "ListItem", "position": 2, "name": "Nexus AI", "item": `${domain}/nexus-ai` },
    { "@type": "ListItem", "position": 3, "name": "For Founders", "item": canonical }
  ]
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": seoTitle,
  "description": seoDescription,
  "url": canonical,
  "publisher": { "@type": "Organization", "name": "Aixentrix", "url": domain }
};
---

<Layout title={seoTitle} description={seoDescription} canonical={canonical} schemas={[breadcrumbSchema, webPageSchema]}>
  <Navbar client:load />

  <main class="pt-32 pb-24 max-w-4xl mx-auto px-6 relative z-10 font-sans text-ink-900">
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-semibold text-ink-500 uppercase tracking-widest">
      <a href="/" class="hover:text-accent-600 transition-colors">Aixentrix</a>
      <span class="text-ink-300">/</span>
      <a href="/nexus-ai" class="hover:text-accent-600 transition-colors">Nexus AI</a>
      <span class="text-ink-300">/</span>
      <span class="text-ink-900 font-bold">For Founders</span>
    </nav>

    <article class="bg-cream-50 rounded-sm border border-ink-900/15 shadow-2xl p-8 md:p-12 vintage-border relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-400/5 to-transparent pointer-events-none" />

      <header class="relative z-10 mb-12 text-center border-b border-ink-900/10 pb-8">
        <div class="vintage-divider text-xs font-semibold uppercase tracking-[0.3em] mb-4 text-ink-500">
          <span class="flourish text-base">✦</span>
          <span class="mx-3">Use Case</span>
          <span class="flourish text-base">✦</span>
        </div>
        <h1 class="font-serif text-4xl md:text-5xl font-medium text-ink-900 leading-tight mb-6">
          Nexus AI for Founders & Executives
        </h1>
        <p class="text-base text-ink-700 leading-relaxed max-w-2xl mx-auto font-serif italic">
          Gain 360-degree organizational clarity, track critical commitments, and protect your most scarce resource: mental bandwidth.
        </p>
      </header>

      <div class="relative z-10 prose prose-stone max-w-none text-sm text-ink-700 leading-relaxed space-y-8 font-sans">
        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">The Executive Bandwidth Bottleneck</h2>
          <p>
            As a founder or CEO, your calendar is packed with fundraising, customer discovery, hiring, and product reviews. In between meetings, dozens of verbal commitments are made in Slack channels or Zoom calls: <em>"We'll review the revised cap table tomorrow,"</em> or <em>"Let's check in with the design agency on Friday."</em>
          </p>
          <p>
            Keeping mental tabs on all open commitments across 5 to 50 direct and indirect reports quickly leads to cognitive overload and operational blind spots.
          </p>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">Your Autonomous Chief of Staff</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-4">
            <div class="p-5 bg-cream-100/80 rounded-sm border border-ink-900/10">
              <h3 class="font-serif text-base font-semibold text-ink-900 mb-2 flex items-center gap-2">
                <CheckSquare class="w-4 h-4 text-accent-700" /> Automated Commitment Audits
              </h3>
              <p class="text-xs text-ink-600">
                Nexus AI monitors promises made by you or to you across communication channels, highlighting overdue action items without needing manual follow-up messages.
              </p>
            </div>
            <div class="p-5 bg-cream-100/80 rounded-sm border border-ink-900/10">
              <h3 class="font-serif text-base font-semibold text-ink-900 mb-2 flex items-center gap-2">
                <Compass class="w-4 h-4 text-accent-700" /> Morning Strategic Brief
              </h3>
              <p class="text-xs text-ink-600">
                Receive a 2-minute daily synthesized briefing of key decisions, customer escalation risks, and meeting pre-reads every morning at 8:00 AM.
              </p>
            </div>
          </div>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">High Trust, Zero Micromanagement</h2>
          <p>
            Because Nexus AI indexes factual communication streams and provides verified citations, founders can check the exact context of any project milestone or customer issue without interrupting team members or scheduling redundant status meetings.
          </p>
        </section>

        <div class="pt-8 border-t border-ink-900/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/nexus-ai" class="text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            ← Back to Nexus AI
          </a>
          <a href="https://app.aixentrix.com/?auth=signup" class="px-6 py-2.5 rounded-sm bg-ink-900 hover:bg-accent-600 text-cream-100 text-xs font-semibold uppercase tracking-wider transition-all">
            Start Free Beta
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer client:load />
</Layout>
