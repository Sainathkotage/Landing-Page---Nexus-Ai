---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/landing/Navbar';
import { Footer } from '../../components/landing/Footer';
import { Rocket, Zap, Users, Brain, ArrowUpRight, ArrowRight, ShieldCheck, CheckCircle2 } from 'lucide-react';

const domain = "https://www.aixentrix.com";
const canonical = `${domain}/nexus-ai/for-startups`;

const seoTitle = "Nexus AI for Startups — Retain Knowledge & Scale Rapidly | Aixentrix";
const seoDescription = "Learn how fast-growing startups use Nexus AI as an AI Chief of Staff to preserve institutional knowledge, onboard new hires 10x faster, and avoid repeating past mistakes.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": domain },
    { "@type": "ListItem", "position": 2, "name": "Nexus AI", "item": `${domain}/nexus-ai` },
    { "@type": "ListItem", "position": 3, "name": "For Startups", "item": canonical }
  ]
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": seoTitle,
  "description": seoDescription,
  "url": canonical,
  "publisher": { "@type": "Organization", "name": "Aixentrix", "url": domain }
};
---

<Layout title={seoTitle} description={seoDescription} canonical={canonical} schemas={[breadcrumbSchema, webPageSchema]}>
  <Navbar client:load />

  <main class="pt-32 pb-24 max-w-4xl mx-auto px-6 relative z-10 font-sans text-ink-900">
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-semibold text-ink-500 uppercase tracking-widest">
      <a href="/" class="hover:text-accent-600 transition-colors">Aixentrix</a>
      <span class="text-ink-300">/</span>
      <a href="/nexus-ai" class="hover:text-accent-600 transition-colors">Nexus AI</a>
      <span class="text-ink-300">/</span>
      <span class="text-ink-900 font-bold">For Startups</span>
    </nav>

    <article class="bg-cream-50 rounded-sm border border-ink-900/15 shadow-2xl p-8 md:p-12 vintage-border relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-400/5 to-transparent pointer-events-none" />

      <header class="relative z-10 mb-12 text-center border-b border-ink-900/10 pb-8">
        <div class="vintage-divider text-xs font-semibold uppercase tracking-[0.3em] mb-4 text-ink-500">
          <span class="flourish text-base">✦</span>
          <span class="mx-3">Use Case</span>
          <span class="flourish text-base">✦</span>
        </div>
        <h1 class="font-serif text-4xl md:text-5xl font-medium text-ink-900 leading-tight mb-6">
          Nexus AI for High-Growth Startups
        </h1>
        <p class="text-base text-ink-700 leading-relaxed max-w-2xl mx-auto font-serif italic">
          Preserve institutional context, eliminate knowledge silos during rapid hiring, and ensure every team member moves in sync.
        </p>
      </header>

      <div class="relative z-10 prose prose-stone max-w-none text-sm text-ink-700 leading-relaxed space-y-8 font-sans">
        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">The Startup Knowledge Dilemma</h2>
          <p>
            Startups move fast by default. When priorities change weekly and product pivots happen overnight, documentation is the first thing abandoned. Tribal knowledge lives exclusively in the heads of the early team and in chaotic Slack threads.
          </p>
          <p>
            As soon as headcount doubles, momentum slows. New hires spend weeks asking <em>"Where is this documented?"</em> and <em>"Why did we decide to build it this way?"</em>, pulling senior engineers and founders away from critical execution.
          </p>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">How Nexus AI Solves This for Startups</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-4">
            <div class="p-5 bg-cream-100/80 rounded-sm border border-ink-900/10">
              <h3 class="font-serif text-base font-semibold text-ink-900 mb-2 flex items-center gap-2">
                <Brain class="w-4 h-4 text-accent-700" /> Automatic Knowledge Capture
              </h3>
              <p class="text-xs text-ink-600">
                Nexus AI connects to your startup's Slack and Gmail to automatically record decisions, architectural trade-offs, and project rationales without requiring anyone to write wiki pages.
              </p>
            </div>
            <div class="p-5 bg-cream-100/80 rounded-sm border border-ink-900/10">
              <h3 class="font-serif text-base font-semibold text-ink-900 mb-2 flex items-center gap-2">
                <Rocket class="w-4 h-4 text-accent-700" /> 10x Faster Onboarding
              </h3>
              <p class="text-xs text-ink-600">
                New engineers and operators can query Nexus AI directly to understand past decisions, customer context, and key internal stakeholders on day one.
              </p>
            </div>
          </div>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">Seamless Employee Transitions</h2>
          <p>
            In startups, early contributors often transition across roles or move on to new ventures. When that happens, Nexus AI compiles an exhaustive handover brief in minutes, identifying all open commitments, customer conversations, and key technical context so nothing gets dropped.
          </p>
        </section>

        <div class="pt-8 border-t border-ink-900/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/nexus-ai" class="text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            ← Back to Nexus AI
          </a>
          <a href="https://app.aixentrix.com/?auth=signup" class="px-6 py-2.5 rounded-sm bg-ink-900 hover:bg-accent-600 text-cream-100 text-xs font-semibold uppercase tracking-wider transition-all">
            Join the Free Beta
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer client:load />
</Layout>
