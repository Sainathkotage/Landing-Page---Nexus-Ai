---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/landing/Navbar';
import { Footer } from '../../components/landing/Footer';
import { Users, Zap, ShieldAlert, CheckCircle2, ArrowUpRight } from 'lucide-react';

const domain = "https://www.aixentrix.com";
const canonical = `${domain}/nexus-ai/team-intelligence`;

const seoTitle = "AI Team Intelligence | Nexus AI by Aixentrix";
const seoDescription = "Discover how Nexus AI powers proactive team intelligence, cross-functional context synthesis, and real-time commitment monitoring for high-velocity teams.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": domain },
    { "@type": "ListItem", "position": 2, "name": "Nexus AI", "item": `${domain}/nexus-ai` },
    { "@type": "ListItem", "position": 3, "name": "Team Intelligence", "item": canonical }
  ]
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": seoTitle,
  "description": seoDescription,
  "url": canonical,
  "publisher": { "@type": "Organization", "name": "Aixentrix", "url": domain }
};
---

<Layout title={seoTitle} description={seoDescription} canonical={canonical} schemas={[breadcrumbSchema, webPageSchema]}>
  <Navbar client:load />

  <main class="pt-32 pb-24 max-w-4xl mx-auto px-6 relative z-10 font-sans text-ink-900">
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-semibold text-ink-500 uppercase tracking-widest font-sans">
      <a href="/" class="hover:text-accent-600 transition-colors">Aixentrix</a>
      <span class="text-ink-300">/</span>
      <a href="/nexus-ai" class="hover:text-accent-600 transition-colors">Nexus AI</a>
      <span class="text-ink-300">/</span>
      <span class="text-ink-900 font-bold">Team Intelligence</span>
    </nav>

    <article class="bg-cream-50 rounded-sm border border-ink-900/15 shadow-2xl p-8 md:p-12 vintage-border relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-400/5 to-transparent pointer-events-none" />

      <header class="relative z-10 mb-12 text-center border-b border-ink-900/10 pb-8">
        <div class="vintage-divider text-xs font-semibold uppercase tracking-[0.3em] mb-4 text-ink-500">
          <span class="flourish text-base">✦</span>
          <span class="mx-3">Proactive Coordination</span>
          <span class="flourish text-base">✦</span>
        </div>
        <h1 class="font-serif text-4xl md:text-5xl font-medium text-ink-900 leading-tight mb-6">
          AI Team Intelligence
        </h1>
        <p class="text-base text-ink-700 leading-relaxed max-w-2xl mx-auto font-serif italic">
          Moving teams from passive project status updates to active, autonomous operational alignment.
        </p>
      </header>

      <div class="relative z-10 prose prose-stone max-w-none text-sm text-ink-700 leading-relaxed space-y-8 font-sans">
        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">What Is Team Intelligence?</h2>
          <p>
            Team intelligence is the ability of an organization to synthesize distributed insights, detect operational bottlenecks, and maintain synchronicity without endless status meetings and manual pinging.
          </p>
          <p>
            Nexus AI serves as an active intelligence layer across your organization, continuously connecting the dots between product releases, engineering roadmaps, and client discussions.
          </p>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">Key Capabilities</h2>
          <div class="space-y-4 my-4">
            <div class="p-5 bg-cream-100/70 border border-ink-900/10 rounded-sm">
              <h3 class="font-serif text-base font-semibold text-ink-900 mb-1">Cross-Functional Context Synthesis</h3>
              <p class="text-xs text-ink-700">When sales mentions a feature request to a customer, Nexus AI checks the engineering backlog and provides instant factual context on the actual roadmap timeline.</p>
            </div>
            <div class="p-5 bg-cream-100/70 border border-ink-900/10 rounded-sm">
              <h3 class="font-serif text-base font-semibold text-ink-900 mb-1">Commitment & Follow-Through Audits</h3>
              <p class="text-xs text-ink-700">Automatically tracks verbal and written commitments made during client calls or team check-ins, ensuring key obligations don't slip through the cracks.</p>
            </div>
            <div class="p-5 bg-cream-100/70 border border-ink-900/10 rounded-sm">
              <h3 class="font-serif text-base font-semibold text-ink-900 mb-1">Executive Pulse Summaries</h3>
              <p class="text-xs text-ink-700">Delivers concise daily and weekly operational memos to founders and executives, summarizing progress, blockers, and key decisions across teams.</p>
            </div>
          </div>
        </section>

        <div class="pt-6 border-t border-ink-900/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/nexus-ai" class="text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            ← Back to Nexus AI
          </a>
          <a href="https://app.aixentrix.com/?auth=signup" class="px-6 py-2.5 rounded-sm bg-ink-900 hover:bg-accent-600 text-cream-100 text-xs font-semibold uppercase tracking-wider transition-all">
            Join the Free Beta
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
