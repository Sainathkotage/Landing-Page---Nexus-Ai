---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/landing/Navbar';
import { Footer } from '../../components/landing/Footer';
import { Globe, Clock, MessageSquare, Sparkles, ArrowRight, ArrowLeft } from 'lucide-react';

const domain = "https://www.aixentrix.com";
const canonical = `${domain}/nexus-ai/for-remote-teams`;

const seoTitle = "Nexus AI for Remote Teams — Asynchronous Alignment | Aixentrix";
const seoDescription = "Empower distributed and remote teams with Nexus AI. Bridge time zones, capture async decisions, eliminate status meetings, and keep everyone aligned.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": domain },
    { "@type": "ListItem", "position": 2, "name": "Nexus AI", "item": `${domain}/nexus-ai` },
    { "@type": "ListItem", "position": 3, "name": "For Remote Teams", "item": canonical }
  ]
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": seoTitle,
  "description": seoDescription,
  "url": canonical,
  "publisher": { "@type": "Organization", "name": "Aixentrix", "url": domain }
};
---

<Layout title={seoTitle} description={seoDescription} canonical={canonical} schemas={[breadcrumbSchema, webPageSchema]}>
  <Navbar client:load />

  <main class="pt-32 pb-24 max-w-4xl mx-auto px-6 relative z-10 font-sans text-ink-900">
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-semibold text-ink-500 uppercase tracking-widest">
      <a href="/" class="hover:text-accent-600 transition-colors">Aixentrix</a>
      <span class="text-ink-300">/</span>
      <a href="/nexus-ai" class="hover:text-accent-600 transition-colors">Nexus AI</a>
      <span class="text-ink-300">/</span>
      <span class="text-ink-900 font-bold">For Remote Teams</span>
    </nav>

    <article class="bg-cream-50 rounded-sm border border-ink-900/15 shadow-2xl p-8 md:p-12 vintage-border relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-400/5 to-transparent pointer-events-none" />

      <header class="relative z-10 mb-12 text-center border-b border-ink-900/10 pb-8">
        <div class="vintage-divider text-xs font-semibold uppercase tracking-[0.3em] mb-4 text-ink-500">
          <span class="flourish text-base">✦</span>
          <span class="mx-3">Use Case</span>
          <span class="flourish text-base">✦</span>
        </div>
        <h1 class="font-serif text-4xl md:text-5xl font-medium text-ink-900 leading-tight mb-6">
          Nexus AI for Distributed & Remote Teams
        </h1>
        <p class="text-base text-ink-700 leading-relaxed max-w-2xl mx-auto font-serif italic">
          Bridge time zone gaps, capture asynchronous decisions, and stay aligned without midnight video calls.
        </p>
      </header>

      <div class="relative z-10 prose prose-stone max-w-none text-sm text-ink-700 leading-relaxed space-y-8 font-sans">
        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">The Reality of Asynchronous Collaboration</h2>
          <p>
            When teams are spread across North America, Europe, and Asia-Pacific, synchronous meetings are painful and rare. Crucial decisions are made in asynchronous chat threads while half the company is asleep.
          </p>
          <p>
            Waking up to 500 unread Slack messages creates anxiety and cognitive drag. Teammates either spend the first 90 minutes of their workday scrolling through chat history or miss key developments entirely.
          </p>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">How Nexus AI Empowers Remote Teams</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-4">
            <div class="p-5 bg-cream-100/80 rounded-sm border border-ink-900/10">
              <h3 class="font-serif text-base font-semibold text-ink-900 mb-2 flex items-center gap-2">
                <Clock class="w-4 h-4 text-accent-700" /> Timezone-Aware Morning Brief
              </h3>
              <p class="text-xs text-ink-600">
                Nexus AI synthesizes what happened across global channels during your off-hours, presenting the key decisions, blockers, and assigned tasks in your local morning digest.
              </p>
            </div>
            <div class="p-5 bg-cream-100/80 rounded-sm border border-ink-900/10">
              <h3 class="font-serif text-base font-semibold text-ink-900 mb-2 flex items-center gap-2">
                <Globe class="w-4 h-4 text-accent-700" /> 24/7 Context Answers
              </h3>
              <p class="text-xs text-ink-600">
                Instead of waiting 12 hours for an overseas colleague to wake up and answer a clarifying question, ask Nexus AI to retrieve the historical decision and project rationale instantly.
              </p>
            </div>
          </div>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl font-semibold text-ink-900">Fewer Meetings, Higher Velocity</h2>
          <p>
            By turning team communication into a living, searchable memory graph, remote organizations can replace weekly status alignment meetings with autonomous intelligence, giving teammates more uninterrupted deep work time.
          </p>
        </section>

        <div class="pt-8 border-t border-ink-900/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/nexus-ai" class="text-xs font-semibold text-accent-700 hover:text-accent-800 uppercase tracking-wider">
            ← Back to Nexus AI
          </a>
          <a href="https://app.aixentrix.com/?auth=signup" class="px-6 py-2.5 rounded-sm bg-ink-900 hover:bg-accent-600 text-cream-100 text-xs font-semibold uppercase tracking-wider transition-all">
            Join the Free Beta
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer client:load />
</Layout>
